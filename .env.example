# Copy to .env (or .env.local) and fill in.

# Neon Postgres (Prisma). Apply schema with `npx prisma migrate deploy` — never `db push`.
DATABASE_URL=                     # Neon pooled connection string
DATABASE_URL_UNPOOLED=            # optional: direct connection for migrations (default: DATABASE_URL without "-pooler")

# Auth.js — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=                   # optional: Google sign-in appears only when both are set
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=                     # comma list; these emails get the admin role on sign-up

# Google Sheets service account (read-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=       # private key, \n-escaped

JOB_SECRET=                       # shared with n8n
SFG_API_BASE_URL=                 # TBD (Samrat)
SFG_API_TOKEN=                    # TBD
SFG_CLIENT_MODE=fixture           # fixture | http
TZ_BUSINESS=Asia/Kolkata
