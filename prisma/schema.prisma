// Tables per Armouring_5_Dashboard_Flow_and_Rules.md (Rev 3).
// No enums: allowed values are String columns + CHECK constraints in the migration SQL.
// Never `prisma db push`. Schema changes go through migration files only.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // .ts import extensions so prisma/seed.ts runs on plain Node 24 (type stripping), no tsx.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique // stored lowercased
  name         String?
  passwordHash String?   @map("password_hash") // null for Google-only accounts
  role         String    @default("viewer") // CHECK: viewer | admin
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz

  @@map("users")
}

// ── Operational (md §4, §7.5, §8) ───────────────────────────────────────
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model RefreshLog {
  id          BigInt    @id @default(autoincrement())
  job         String
  source      String
  startedAt   DateTime  @map("started_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz
  rows        Int?
  status      String // CHECK: running | ok | error | skipped
  error       String?
  triggeredBy String?   @map("triggered_by")

  @@index([source, startedAt])
  @@map("refresh_log")
}

model Alert {
  id              BigInt    @id @default(autoincrement())
  rule            String
  machineCode     String    @map("machine_code")
  message         String
  payload         Json?
  firstSeen       DateTime  @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen        DateTime  @default(now()) @map("last_seen") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz
  escalationLevel Int       @default(0) @map("escalation_level")

  // Partial unique (rule, machine_code) WHERE resolved_at IS NULL lives in the migration SQL.
  @@map("alerts")
}

// "ARMOURING NO- 5" (production entries), "AR005" (ERP) -> "ARM5"
model MachineAlias {
  alias       String @id
  machineCode String @map("machine_code")

  @@map("machine_alias")
}

// ── SFG dashboard sources (md §3) ───────────────────────────────────────
model OrderLine {
  prodOrder     String   @map("prod_order")
  stage         String
  sfgItem       String   @map("sfg_item")
  customer      String?
  cable         String?
  coresPerCable Float?   @map("cores_per_cable")
  orderedQty    Float    @map("ordered_qty")
  doneQty       Float    @map("done_qty")
  qtyUnit       String   @map("qty_unit") // CHECK: CORE_KM | CABLE_KM
  approved      Boolean?
  loadedAt      DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@id([prodOrder, stage, sfgItem])
  @@map("order_lines")
}

model ProductionEntry {
  id           String   @id
  machineRaw   String   @map("machine_raw")
  machineCode  String   @map("machine_code")
  prodOrderRaw String?  @map("prod_order_raw") // may hold two order numbers
  prodOrders   String[] @default([]) @map("prod_orders")
  cable        String?
  drumNo       String?  @map("drum_no")
  qtyM         Float    @map("qty_m")
  enteredAt    DateTime @map("entered_at") @db.Timestamptz
  enteredBy    String?  @map("entered_by")
  shiftDay     DateTime @map("shift_day") @db.Date
  shift        String // CHECK: DAY | NIGHT
  isDuplicate  Boolean  @default(false) @map("is_duplicate") // same drum twice on one machine
  loadedAt     DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@index([machineCode, shiftDay])
  @@map("production_entries")
}

model MenPosted {
  date     DateTime @db.Date
  shift    String
  empCode  String   @map("emp_code")
  costCode String   @map("cost_code")
  name     String?
  loadedAt DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@id([date, shift, empCode, costCode])
  @@map("men_posted")
}

// N.D. batches are dropped by the loader (md §7.1), never stored.
model Stock {
  id       BigInt    @id @default(autoincrement())
  itemCode String    @map("item_code")
  item     String?
  batch    String?
  godown   String?
  qty      Float
  mfgDate  DateTime? @map("mfg_date") @db.Date
  isDead   Boolean   @default(false) @map("is_dead")
  loadedAt DateTime  @default(now()) @map("loaded_at") @db.Timestamptz

  @@index([itemCode])
  @@map("stock")
}

// ── Google Sheets sources (md §3) ───────────────────────────────────────
model SfgUnconsumed {
  id           BigInt   @id @default(autoincrement())
  prodOrder    String   @map("prod_order")
  stage        String
  prevStage    String?  @map("prev_stage")
  item         String?
  customer     String?
  unconsumedKm Float    @map("unconsumed_km")
  loadedAt     DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@index([stage])
  @@map("sfg_unconsumed")
}

model PlanJob {
  machineCode  String    @map("machine_code")
  rowNo        Int       @map("row_no")
  planDate     DateTime? @map("plan_date") @db.Date
  cableItem    String?   @map("cable_item")
  armourType   String?   @map("armour_type")
  armourSize   String?   @map("armour_size")
  cableLengthM Float?    @map("cable_length_m")
  priority     Int?
  markComplete Boolean   @default(false) @map("mark_complete")
  loadedAt     DateTime  @default(now()) @map("loaded_at") @db.Timestamptz

  @@id([machineCode, rowNo])
  @@map("plan_jobs")
}

model Lot {
  lotNo         String   @id @map("lot_no")
  machineCode   String   @map("machine_code")
  cableItem     String?  @map("cable_item")
  armourType    String?  @map("armour_type")
  armourSize    String?  @map("armour_size")
  bobbinsNeeded Int      @map("bobbins_needed")
  bobbinsWound  Int      @default(0) @map("bobbins_wound")
  approved      Boolean  @default(false)
  completed     Boolean  @default(false)
  priority      Int?
  loadedAt      DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@map("lots")
}

model BobbinLog {
  date            DateTime @db.Date
  shift           String
  bobbinNo        String   @map("bobbin_no")
  offTime         String   @map("off_time") // HH:MM as entered
  spoolingMachine String?  @map("spooling_machine")
  operator        String?
  lotNo           String?  @map("lot_no")
  item            String?
  turns           Int?
  outerDiaMm      Float?   @map("outer_dia_mm")
  lengthM         Float?   @map("length_m")
  weightKg        Float?   @map("weight_kg")
  loadedAt        DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@id([date, shift, bobbinNo, offTime])
  @@map("bobbin_log")
}

model BobbinStatus {
  date     DateTime @db.Date
  state    String // loaded, filled, empty, badly wound, workshop, broken
  item     String   @default("")
  count    Int
  loadedAt DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@id([date, state, item])
  @@map("bobbin_status")
}

model BobbinsOwned {
  fromDate DateTime @id @map("from_date") @db.Date
  owned    Int
  loadedAt DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@map("bobbins_owned")
}

model MachineSpeed {
  machineCode String   @id @map("machine_code")
  stage       String?
  kmPerDay    Float    @map("km_per_day")
  daysPerWeek Int?     @map("days_per_week")
  loadedAt    DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@map("machine_speeds")
}

model MachineDaily {
  machineCode  String   @id @map("machine_code")
  name         String?
  erpCostCode  String?  @map("erp_cost_code")
  mustRun      Boolean  @default(false) @map("must_run")
  shiftsPerDay Int?     @map("shifts_per_day")
  menPerShift  Int?     @map("men_per_shift")
  loadedAt     DateTime @default(now()) @map("loaded_at") @db.Timestamptz

  @@map("machine_daily")
}

// ── KGP cards (docs/KGP_4_Cards_Build_Spec.md) ──────────────────────────
// Every issue is kept. One data table per card; each row points at its issue.
model CardIssue {
  id          Int       @id @default(autoincrement())
  version     String // as written in the sheet's Version column; it has no year, so it is unique only with d0
  issueDate   DateTime  @map("issue_date") @db.Date
  rev         Int
  d0          DateTime  @db.Date // first day of the card
  loadedAt    DateTime  @default(now()) @map("loaded_at") @db.Timestamptz
  s8PulledAt  String?   @map("s8_pulled_at") // issues built in the app: time of the SFG pull they were built from
  notPlanned  String[]  @default([]) @map("not_planned") // orders / items the build could not plan, with the reason
  prevIssueId   Int?    @map("prev_issue_id") // the issue this one replaces (Card 3 guide v4, section 2)
  issueNote     String  @default("") @map("issue_note") // the text the issuer writes for this version
  review        Boolean @default(false) // true until the issue is confirmed: prints the review mark
  rosterName    String? @map("roster_name") // title of the roster sheet Card 2 was built from
  labourProblem String? @map("labour_problem") // why Card 2 could not be built, if so
  drumProblem   String? @map("drum_problem") // why Cards 3 and 4 could not be built, if so
  fingerprint   String? // hash of what was built: a scheduled run stores no new revision when it is unchanged

  plan         CardPlan[]
  labour       CardLabour[]
  spareMen     CardSpareMen[]
  drumNeed     CardDrumNeed[]
  drumAssembly CardDrumAssembly[]
  drumStock    CardDrumStock[]

  @@unique([version, d0])
  @@unique([issueDate, rev])
  @@map("card_issues")
}

// Card 1: one planned job per machine per day.
model CardPlan {
  id         Int       @id @default(autoincrement())
  issueId    Int       @map("issue_id")
  issue      CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rowNo      Int       @map("row_no") // the tab's row order = the order jobs run in
  day        DateTime  @db.Date
  process    String
  machine    String
  prodOrder  String    @map("prod_order")
  mc         String
  partyCable String    @map("party_cable")
  lot        String
  qty        Float
  unit       String
  sizeCore   String    @map("size_core")
  material   String
  feed       String
  feedStatus String    @map("feed_status") // CHECK: ok | drum | wait
  job        String

  @@index([issueId, rowNo])
  @@map("card_plan")
}

// Card 2: operator and helpers per machine per shift.
model CardLabour {
  id        Int       @id @default(autoincrement())
  issueId   Int       @map("issue_id")
  issue     CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rowNo     Int       @map("row_no")
  day       DateTime  @db.Date
  shift     String // CHECK: Day | Night
  machine   String
  operator  String?
  helpers   String[]  @default([])
  menNeeded Int       @map("men_needed")
  menGiven  Int       @map("men_given")
  note      String?

  @@index([issueId, rowNo])
  @@map("card_labour")
}

// Card 2: men on duty but not on a machine.
model CardSpareMen {
  issueId Int       @map("issue_id")
  issue   CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  day     DateTime  @db.Date
  shift   String // CHECK: Day | Night
  men     String[]  @default([])

  @@id([issueId, day, shift])
  @@map("card_spare_men")
}

// Card 3: finished-goods drums needed per order.
model CardDrumNeed {
  id          Int       @id @default(autoincrement())
  issueId     Int       @map("issue_id")
  issue       CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rowNo       Int       @map("row_no")
  usedOn      DateTime  @map("used_on") @db.Date
  readyBy     DateTime  @map("ready_by") @db.Date
  late        Boolean   @default(false)
  drumSize    String    @map("drum_size")
  drumsNeeded Int       @map("drums_needed")
  fromStock   Int       @map("from_stock")
  toAssemble  Int       @map("to_assemble")
  prodOrder   String    @map("prod_order")
  partyCable  String    @map("party_cable")
  lot         String
  note        String?

  @@index([issueId, rowNo])
  @@map("card_drum_need")
}

// Card 4: drums to assemble per day.
model CardDrumAssembly {
  id            Int       @id @default(autoincrement())
  issueId       Int       @map("issue_id")
  issue         CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rowNo         Int       @map("row_no")
  assembleBy    DateTime  @map("assemble_by") @db.Date
  was           DateTime? @db.Date // the date it should have been ready, when late
  drumSize      String    @map("drum_size")
  drums         Int
  flangesNeeded Int       @map("flanges_needed")
  flangesFrom   String    @map("flanges_from")
  prodOrder     String    @map("prod_order")
  partyCable    String    @map("party_cable")
  lot           String
  usedOn        DateTime  @map("used_on") @db.Date

  @@index([issueId, rowNo])
  @@map("card_drum_assembly")
}

// Cards 3 and 4: drum and flange stock as it was at that issue, so an old card keeps its figures.
model CardDrumStock {
  issueId    Int       @map("issue_id")
  issue      CardIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sizeKey    String    @map("size_key")
  drumSize   String    @map("drum_size")
  drums      Int?
  flangesKgp Int?      @map("flanges_kgp")
  flangesPp  Int?      @map("flanges_pp")

  @@id([issueId, sizeKey])
  @@map("card_drum_stock")
}

// ── Card 1 sources (docs/final guide for card 1.md, section 3) ───────────
// Replaced whole on every sync. The guide's Lot / Order / OrderLine are Kgp* here: Lot and OrderLine
// already belong to the Armouring 5 dashboard. The guide's CardJob is CardPlan above.
// No foreign keys between them: an order line may name an order Club & Run does not list.
model SyncRun {
  id         Int      @id @default(autoincrement())
  source     String
  tab        String
  at         DateTime @default(now()) @db.Timestamptz
  rows       Int
  ok         Boolean
  s8PulledAt String?  @map("s8_pulled_at")

  @@map("sync_runs")
}

model KgpLot {
  lotNo        String  @id @map("lot_no")
  runOrder     Int     @map("run_order")
  approvedByMd Boolean @map("approved_by_md")

  @@map("kgp_lots")
}

model KgpOrder {
  prodOrder     String  @id @map("prod_order")
  mcNo          String? @map("mc_no")
  party         String?
  cable         String?
  sizeSqmm      Float?  @map("size_sqmm")
  cores         Float?
  insulation    String?
  lotNo         String? @map("lot_no")
  runOrderInLot Int?    @map("run_order_in_lot")
  supplyFrom    String? @map("supply_from")

  @@map("kgp_orders")
}

model KgpOrderLine {
  id        Int     @id @default(autoincrement())
  prodOrder String  @map("prod_order")
  fgType    String? @map("fg_type")
  stage     String
  sfgCode   String  @map("sfg_code")
  sfgItem   String  @map("sfg_item")
  netQty    Float   @map("net_qty")
  doneQty   Float   @map("done_qty")
  balance   Float
  scope     String?
  sfgBom    String? @map("sfg_bom")

  @@unique([prodOrder, stage, sfgCode])
  @@map("kgp_order_lines")
}

model BomLine {
  id           Int    @id @default(autoincrement())
  sfgBom       String @map("sfg_bom")
  lineNo       Float  @map("line_no")
  materialCode String @map("material_code")
  material     String
  kgPerKm      Float  @map("kg_per_km")

  @@unique([sfgBom, lineNo])
  @@map("bom_lines")
}

model RmStock {
  itemCode       String @id @map("item_code")
  item           String
  qtyForPlanning Float  @map("qty_for_planning")

  @@map("rm_stock")
}

model MachineMen {
  machine      String  @id
  menPerShift  Int?    @map("men_per_shift")
  mustRunDaily Boolean @map("must_run_daily")

  @@map("machine_men")
}

model MdRules {
  id        Int      @id @default(autoincrement())
  code      String? // the rule's own number, e.g. CR-B-04; a replacement keeps the code of the rule it replaces
  topic     String // the rule's title
  rule      String // MD sir's wording, as given
  summary   String? // written by the agent(reframed)
  details   Json? // the rest of the rule as given: section, rule_type, condition, on_fail, message_on_fail ...
  givenOn   DateTime @map("given_on") @db.Date
  newRuleId Int?     @map("new_rule_id") // set on an old rule: the rule that replaced it
  newRule   MdRules?  @relation("OldToNew", fields: [newRuleId], references: [id])
  oldRules  MdRules[] @relation("OldToNew") // the rules this one replaced
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([topic])
  @@index([code])
  @@map("md_rules")
}